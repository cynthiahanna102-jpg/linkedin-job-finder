# n8n webhook that powers the recruiter chatbot (src/app/api/chat)
N8N_CHAT_WEBHOOK_URL=https://your-n8n-instance/webhook/your-path

# n8n webhook that powers the AI Job Match page (src/app/api/jobmatch)
# Production URL of the "Find Jobs Webhook" node in the JobMatch AI workflow.
N8N_JOBMATCH_WEBHOOK_URL=https://your-n8n-instance/webhook/find-jobs
